---
/**
 * Footer.astro — shared site footer. `isHome` switches same-page Quick Links
 * to bare anchors (#top, #contact); About Us is exempt — it ALWAYS targets the
 * /about page, on every page including home (owner, 2026-07-13: "link all
 * links to this page."). The single <span id="year"> is stamped site-wide by
 * the sanctioned year-stamp JS in main.js.
 */
import Brand from "../brand/Brand.astro";
import { SERVICES } from "../../data/services.ts";

interface Props {
  isHome?: boolean;
}
const { isHome = false } = Astro.props;

const home = isHome ? "#top" : "/";
const sec = (anchor: string) => (isHome ? anchor : `/${anchor}`);
---
<footer class="site-footer">
  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <Brand class="site-footer__logo" />
      <p class="site-footer__blurb">A MASI-certified deep-tech company.</p>
      <p class="site-footer__tagline">Immersive experiences that change how teams train and decide.</p>
    </div>
    <div>
      <h3 class="footer-h">Email</h3>
      <p><a href="mailto:contact@infixr.com">contact@infixr.com</a></p>
    </div>
    <div>
      <h3 class="footer-h">Quick Links</h3>
      <ul class="footer-links">
        <li><a href={home}>Home</a></li>
        {SERVICES.map(([slug, label]) => (
          <li><a href={`/services#${slug}`}>{label}</a></li>
        ))}
        <li><a href="/about">About Us</a></li>
        <li><a href={sec("#contact")}>Contact</a></li>
      </ul>
    </div>
    <div>
      <h3 class="footer-h">Social</h3>
      <ul class="social-links" aria-label="Social media">
        <li><a href="https://www.linkedin.com/company/infixr/" aria-label="LinkedIn" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8.04h4.56V24H.22V8.04zM7.86 8.04h4.37v2.18h.06c.61-1.15 2.11-2.36 4.34-2.36 4.64 0 5.5 3.06 5.5 7.03V24h-4.56v-7.34c0-1.75-.03-4-2.44-4-2.44 0-2.81 1.9-2.81 3.87V24H7.86V8.04z"/></svg>
        </a></li>
        <li><a href="https://www.instagram.com/infixr" aria-label="Instagram" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a></li>
      </ul>
    </div>
    <div>
      <h3 class="footer-h">Location</h3>
      <address>InfiXR<br>Guwahati, Assam<br>781028</address>
    </div>
  </div>
  <p class="site-footer__copy">Copyright &copy; <span id="year">2026</span> &nbsp;|&nbsp; Powered by InfiXR</p>
</footer>
