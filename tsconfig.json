{
  // Node-native project: tsc is used ONLY as a type checker (`tsc --noEmit`) —
  // Node (≥24) runs the .ts directly via type stripping (build.ts, server.ts,
  // lint.ts, and the src/ render fns). So this config is tuned for checking,
  // not emitting. Type stripping = erasable syntax only: no enums, namespaces,
  // or constructor parameter properties (none exist in this codebase).
  "compilerOptions": {
    // Node type-stripping supports modern syntax + ESM natively.
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // The codebase imports siblings WITH the .ts extension (e.g.
    // `import { html } from "./templates/html.ts"`) — REQUIRED at runtime by
    // Node's type stripping (it never rewrites specifiers). Allowed only with noEmit.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // `strict` is the real safety net (caught nothing in glass-card.ts → that code
    // is sound; it's what guards the Effect Schema / Option usage). Left OFF:
    // noUncheckedIndexedAccess — it'd flag dozens of provably-present literal index
    // accesses across the EXISTING code (carousel WHO_SLIDES[n], regex groups in
    // data/posts.ts parseFrontMatter, etc.) that aren't bugs. Adopting it is a separate codebase-wide
    // policy change, not part of this work; keep the gate green on the tree as-is.
    "strict": true,
    "noFallthroughCasesInSwitch": true,

    // Runtime types: node: specifiers used by build.ts / server.ts / data/posts.ts.
    "types": ["node"],

    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": false
  },
  // Type-check the TypeScript sources + build tooling. Generated public/ and the
  // vendored subtrees (vendor/ 3D viewer, repos/ Effect source-for-agents) are
  // excluded — not ours / not type-relevant. repos/ is read-only reference the
  // agent reads; it never enters the build or the type-check surface.
  "include": ["src/**/*.ts", "build.ts", "server.ts", "lint.ts", "vitest.config.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "public", "vendor", "repos", "src/js/hero-3d"]
}
