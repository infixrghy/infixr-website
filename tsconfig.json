{
  // Type-checking config for `astro check` (npm run typecheck), which covers
  // both the .astro templates and the plain .ts modules (content config,
  // utils, lint.ts, tests). Node ≥24 runs the .ts tools (lint.ts, the build
  // hook) directly via type stripping — erasable syntax only: no enums,
  // namespaces, or constructor parameter properties.
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    // The codebase imports siblings WITH the .ts extension (e.g.
    // `import { displayDate } from "../utils/posts.ts"`) — REQUIRED at
    // runtime by Node's type stripping for the tool scripts, and fine for
    // Vite/Astro. Allowed only with noEmit.
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "noFallthroughCasesInSwitch": true,

    // Runtime types: node: specifiers (lint.ts, tests, the build hook) +
    // Astro's client/env types.
    "types": ["node", "astro/client"]
  },
  // Generated dist/ and the vendored subtrees (vendor/ 3D viewer, repos/
  // Effect source-for-agents) are excluded — not ours / not type-relevant.
  "include": [".astro/types.d.ts", "src/**/*", "lint.ts", "vitest.config.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "vendor", "repos", "public"]
}
