{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // ── Entry points ──────────────────────────────────────────────────────────
  // This is an Astro static site. fallow's static module graph can't parse
  // .astro files, so the .ts modules they consume (content.config.ts →
  // post-schema.ts, data/services.ts, utils/*) would all look unused without
  // roots declared here. lint.ts is a standalone tool; test/**/*.test.ts are
  // discovered by vitest's glob (an edge invisible to the module graph);
  // public/js/main.js ships to the browser via a <script> tag.
  "entry": [
    "lint.ts",
    "src/content.config.ts",
    "src/data/services.ts",
    "src/utils/posts.ts",
    "src/utils/nav.ts",
    "public/js/main.js",
    "test/**/*.test.ts"
  ],

  // ── Ignore patterns ───────────────────────────────────────────────────────
  // .astro templates + CSS are consumed by Astro/Vite, not the JS module graph
  // fallow sees: CSS via the global.css @import chain (inlined at build), the
  // hero-3d runtime via a runtime <script> injection (never a JS import).
  "ignorePatterns": [
    "src/**/*.astro",
    "src/css/**",
    "src/components/**/*.css",
    "public/js/hero-3d/**",
    ".claude/hooks/**"
  ],

  // Exports consumed only in-file stay legitimate API surface (e.g. a schema
  // value + its derived type exported from one module).
  "ignoreExportsUsedInFile": true,

  // ── Duplication ───────────────────────────────────────────────────────────
  "duplicates": {
    "minOccurrences": 3
  },

  "rules": {}
}
